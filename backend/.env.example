# Copia este archivo como .env y rellena los valores. Nunca subas .env a Git.

NODE_ENV=development
PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers).
# Incluye el nombre de la base de datos después de la barra: .../vecinhub?...
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/vecinhub?retryWrites=true&w=majority

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Duración de la sesión en horas
JWT_EXPIRES_IN_HOURS=24
# Coste de bcrypt (12 es un buen equilibrio entre seguridad y velocidad)
BCRYPT_ROUNDS=12

# URL del frontend que puede llamar a la API (Vite usa el puerto 5173)
CLIENT_ORIGIN=http://localhost:5173

# Cookies. En local: lax y false. En producción con frontend y API en dominios
# distintos (Vercel + Render): none y true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false