{
  "name": "moravia",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"frontend/**/*.{js,jsx,css,html,json}\" \"backend/{src,scripts,tests}/**/*.js\" \"backend/vitest.config.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,css,html,json}\" \"backend/{src,scripts,tests}/**/*.js\" \"backend/vitest.config.js\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
